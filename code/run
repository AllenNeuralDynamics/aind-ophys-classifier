#!/usr/bin/env bash
set -e

# Nextflow interleaves concurrent tasks into one stream, so tag every line.
TAG="[aind-ophys-classifier@${HOSTNAME:-nohost}]"
trap 'echo "${TAG} run end: exit $?"' EXIT

echo "${TAG} inputs: $(ls ../data | tr '\n' ' ')"

# ROInet weights: point at a pre-staged ROInet.zip when one is mounted, so the
# task does not re-download ~105 MB from osf.io. The archive is 104,997,338
# bytes, which is over GitHub's 100 MiB per-file limit, so it cannot live under
# code/ the way decrosstalk's cellpose weights do.
# The work dir must be writable: roicat unpacks params.json / model.py / *.pth
# next to the archive, so the mount itself cannot be used directly.
# ROINET_WORK_DIR is overridable so this block is testable off Code Ocean.
# Candidate mounts are searched in order; ROINET_STAGED_DIR overrides the list.
# The asset also carries the Torchvision ConvNeXt-Tiny checkpoint that the
# archive's model.py needs: it constructs a pretrained ConvNeXt before loading
# ROInet's own state dictionary, so the checkpoint is a second download unless
# TORCH_HOME points at the mounted copy. Torch resolves it under
# $TORCH_HOME/hub/checkpoints, which is why the asset nests it that way.
ROINET_ASSET_DIR="${ROINET_ASSET_DIR:-/data/roinet}"
ROINET_WORK_DIR="${ROINET_WORK_DIR:-/scratch/roinet}"
ROINET_CANDIDATES=(
  "${ROINET_STAGED_DIR:-}"
  "${ROINET_ASSET_DIR}"
  ../data/2p_ophys_classifier
  ../data/2p_roi_classifier
  ../data/roinet
)
CONVNEXT_REL="torch/hub/checkpoints/convnext_tiny-983f1562.pth"
ROINET_ARGS=()
for candidate in "${ROINET_CANDIDATES[@]}"; do
  [ -n "${candidate}" ] || continue
  if [ -f "${candidate}/ROInet.zip" ]; then
    echo "${TAG} ROInet: using pre-staged ${candidate}/ROInet.zip"
    # Only the archive is copied. roicat unpacks params.json / model.py / *.pth
    # beside it, so its extraction directory must be writable and cannot be the
    # read-only mount. The checkpoint is read in place and never copied.
    mkdir -p "${ROINET_WORK_DIR}"
    cp "${candidate}/ROInet.zip" "${ROINET_WORK_DIR}/"
    ROINET_ARGS=(--roinet_dir="${ROINET_WORK_DIR}")
    if [ -f "${candidate}/${CONVNEXT_REL}" ]; then
      export TORCH_HOME="${candidate}/torch"
      echo "${TAG} ROInet: TORCH_HOME=${TORCH_HOME} (ConvNeXt checkpoint mounted)"
    else
      # A writable cache, never the mount: pointing TORCH_HOME at a path with
      # no checkpoint makes torch try to write the download into read-only /data.
      export TORCH_HOME="${ROINET_WORK_DIR}/torch"
      echo "${TAG} ROInet: ${candidate}/${CONVNEXT_REL} absent;" \
           "TORCH_HOME=${TORCH_HOME} so the ConvNeXt download stays writable"
    fi
    break
  fi
done
if [ ${#ROINET_ARGS[@]} -eq 0 ]; then
  export TORCH_HOME="${ROINET_WORK_DIR}/torch"
  echo "${TAG} ROInet: no pre-staged ROInet.zip in ${ROINET_CANDIDATES[*]};" \
       "it will be downloaded (~105 MB from osf.io), ConvNeXt into ${TORCH_HOME}"
fi

# Plain text, so tag every line.
pip list 2>&1 | sed "s|^|${TAG} pip |"

echo "${TAG} run begin: python -u run_capsule.py ${ROINET_ARGS[*]} $*"
# Unprefixed: log_schema emits JSON records that must stay parseable, and each
# already carries process_name / acquisition_name.
python -u run_capsule.py "${ROINET_ARGS[@]}" "$@" 2>&1
