{
	"version": 1,
	"base_image": "codeocean/pytorch:2.4.0-cuda12.4.0-mambaforge24.5.0-0-python3.12.4-ubuntu22.04",
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"pip3": {
			"packages": [
				{
					"name": "git+https://github.com/AllenNeuralDynamics/aind-ophys-classifier-library.git@75c3719#egg=aind-ophys-classifier-library"
				}
			],
			"options": {},
			"pre_install_options": {}
		}
	},
	"env_variables": [
		{
			"name": "VERSION",
			"value": "0.1.0"
		},
		{
			"name": "CODE_URL",
			"value": "https://github.com/allenNeuralDynamics/aind-ophys-classifier"
		}
	]
}