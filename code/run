#!/usr/bin/env bash
set -e

# Nextflow interleaves concurrent tasks into one stream, so tag every line.
TAG="[aind-ophys-classifier@${HOSTNAME:-nohost}]"
trap 'echo "${TAG} run end: exit $?"' EXIT

echo "${TAG} inputs: $(ls ../data | tr '\n' ' ')"

# ROInet weights: point at a pre-staged ROInet.zip when one is mounted, so the
# task does not re-download ~105 MB from osf.io. The archive is 104,997,338
# bytes, which is over GitHub's 100 MiB per-file limit, so it cannot live under
# code/ the way decrosstalk's cellpose weights do.
# The work dir must be writable: roicat unpacks params.json / model.py / *.pth
# next to the archive, so the mount itself cannot be used directly.
# ROINET_WORK_DIR is overridable so this block is testable off Code Ocean.
# Candidate mounts are searched in order; ROINET_STAGED_DIR overrides the list.
ROINET_WORK_DIR="${ROINET_WORK_DIR:-/scratch/roinet}"
ROINET_CANDIDATES=(
  "${ROINET_STAGED_DIR:-}"
  ../data/2p_ophys_classifier
  ../data/2p_roi_classifier
  ../data/roinet
)
ROINET_ARGS=()
for candidate in "${ROINET_CANDIDATES[@]}"; do
  [ -n "${candidate}" ] || continue
  if [ -f "${candidate}/ROInet.zip" ]; then
    echo "${TAG} ROInet: using pre-staged ${candidate}/ROInet.zip"
    mkdir -p "${ROINET_WORK_DIR}"
    cp "${candidate}/ROInet.zip" "${ROINET_WORK_DIR}/"
    ROINET_ARGS=(--roinet_dir="${ROINET_WORK_DIR}")
    break
  fi
done
if [ ${#ROINET_ARGS[@]} -eq 0 ]; then
  echo "${TAG} ROInet: no pre-staged ROInet.zip in ${ROINET_CANDIDATES[*]}; it will be downloaded (~105 MB from osf.io)"
fi

# Plain text, so tag every line.
pip list 2>&1 | sed "s|^|${TAG} pip |"

echo "${TAG} run begin: python -u run_capsule.py ${ROINET_ARGS[*]} $*"
# Unprefixed: log_schema emits JSON records that must stay parseable, and each
# already carries process_name / acquisition_name.
python -u run_capsule.py "${ROINET_ARGS[@]}" "$@" 2>&1
